# 1 "C:/Users/ray45/zephyrproject/zephyr/include/zephyr/dt-bindings/gpio/arduino-header-r3.h" 1 3 4
# 8 "C:/Users/ray45/zephyrproject/zephyr/boards/st/b_l4s5i_iot01a/arduino_r3_connector.dtsi" 2

/ {
 arduino_header: connector {
  compatible = "arduino-header-r3";
  #gpio-cells = <2>;
  gpio-map-mask = <0xffffffff 0xffffffc0>;
  gpio-map-pass-thru = <0 0x3f>;
  gpio-map = <0 0 &gpioc 5 0>,
      <1 0 &gpioc 4 0>,
      <2 0 &gpioc 3 0>,
      <3 0 &gpioc 2 0>,
      <4 0 &gpioc 1 0>,
      <5 0 &gpioc 0 0>,
      <6 0 &gpioa 1 0>,
      <7 0 &gpioa 0 0>,
      <8 0 &gpiod 14 0>,
      <9 0 &gpiob 0 0>,
      <10 0 &gpioa 3 0>,
      <11 0 &gpiob 4 0>,
      <12 0 &gpiob 1 0>,
      <13 0 &gpioa 4 0>,
      <14 0 &gpiob 2 0>,
      <15 0 &gpioa 15 0>,
      <16 0 &gpioa 2 0>,
      <17 0 &gpioa 7 0>,
      <18 0 &gpioa 6 0>,
      <19 0 &gpioa 5 0>,
      <20 0 &gpiob 9 0>,
      <21 0 &gpiob 8 0>;
 };
};

arduino_i2c: &i2c1 {};

arduino_spi: &spi1 {};

arduino_serial: &uart4 {};
# 11 "C:/Users/ray45/zephyrproject/zephyr/boards/st/b_l4s5i_iot01a/b_l4s5i_iot01a.dts" 2
# 1 "C:/Users/ray45/zephyrproject/zephyr/include/zephyr/dt-bindings/input/input-event-codes.h" 1 3 4
# 12 "C:/Users/ray45/zephyrproject/zephyr/boards/st/b_l4s5i_iot01a/b_l4s5i_iot01a.dts" 2

/ {
 model = "STMicroelectronics B-L4S5I-IOT01A discovery kit";
 compatible = "st,b-l4s5i-iot01a";

 chosen {
  zephyr,console = &usart1;
  zephyr,shell-uart = &usart1;
  zephyr,sram = &sram0;
  zephyr,flash = &flash0;
  zephyr,code-partition = &slot0_partition;
  zephyr,flash-controller = &mx25r6435f;
  zephyr,bt-c2h-uart = &usart1;
  zephyr,bt-hci = &hci_spi;
 };

 leds {
  compatible = "gpio-leds";

  green_led_1: led_1 {
   gpios = <&gpioa 5 (0 << 0)>;
   label = "User LD1";
  };

  green_led_2: led_2 {
   gpios = <&gpiob 14 (0 << 0)>;
   label = "User LD2";
  };
 };

 gpio_keys {
  compatible = "gpio-keys";

  user_button: button {
   label = "User";
   gpios = <&gpioc 13 (1 << 0)>;
   zephyr,code = <11>;
  };
 };

 aliases {
  led0 = &green_led_1;
  sw0 = &user_button;
  watchdog0 = &iwdg;
  accel0 = &lsm6dsl;
 };
};

&clk_lsi {
 status = "okay";
};

&clk_hsi48 {
 status = "okay";
};

&clk_hsi {
 status = "okay";
};

&pll {
 div-m = <4>;
 mul-n = <40>;
 div-q = <2>;
 div-r = <2>;
 clocks = <&clk_hsi>;
 status = "okay";
};

&rcc {
 clocks = <&pll>;
 clock-frequency = <(((80) * 1000) * 1000)>;
 ahb-prescaler = <1>;
 apb1-prescaler = <1>;
 apb2-prescaler = <1>;
};

&usart1 {
 pinctrl-0 = <&usart1_tx_pb6 &usart1_rx_pb7>;
 pinctrl-names = "default";
 current-speed = <115200>;
 status = "okay";
};

&uart4 {
 pinctrl-0 = <&uart4_tx_pa0 &uart4_rx_pa1>;
 pinctrl-names = "default";
 current-speed = <115200>;
};

&i2c1 {
 pinctrl-0 = <&i2c1_scl_pb8 &i2c1_sda_pb9>;
 pinctrl-names = "default";
 status = "okay";
 clock-frequency = <400000>;
};

&i2c2 {
 pinctrl-0 = <&i2c2_scl_pb10 &i2c2_sda_pb11>;
 pinctrl-names = "default";
 status = "okay";
 clock-frequency = <400000>;

 lis3mdl-magn@1e {
  compatible = "st,lis3mdl-magn";
  reg = <0x1e>;
 };

 hts221@5f {
  compatible = "st,hts221";
  reg = <0x5f>;
 };

 lps22hb-press@5d {
  compatible = "st,lps22hb-press";
  reg = <0x5d>;
 };

 lsm6dsl: lsm6dsl@6a {
  compatible = "st,lsm6dsl";
  reg = <0x6a>;
  irq-gpios = <&gpiod 11 (0 << 0)>;
 };

 vl53l0x@29 {
  compatible = "st,vl53l0x";
  reg = <0x29>;
  xshut-gpios = <&gpioc 6 (1 << 0)>;
 };
};

&spi1 {
 pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pa7>;
 pinctrl-names = "default";
 cs-gpios = <&gpioa 2 ((1 << 0) | (1 << 4))>;
 status = "okay";
};

&spi3 {
 pinctrl-0 = <&spi3_sck_pc10 &spi3_miso_pc11 &spi3_mosi_pc12>;
 pinctrl-names = "default";
 status = "okay";

 cs-gpios = <&gpiod 13 (1 << 0)>,
     <&gpioe 0 (1 << 0)>;

 hci_spi: spbtle-rf@0 {
  compatible = "st,hci-spi-v1";
  reg = <0>;
  reset-gpios = <&gpioa 8 (1 << 0)>;
  irq-gpios = <&gpioe 6 ((0 << 0) | (1 << 5))>;
  spi-max-frequency = <(((2) * 1000) * 1000)>;
  spi-hold-cs;
 };

 wifi0: ism43362@1 {
  compatible = "inventek,eswifi";
  spi-max-frequency = <2000000>;
  reg = <1>;
  resetn-gpios = <&gpioe 8 (0 << 0)>;
  boot0-gpios = <&gpiob 12 (0 << 0)>;
  wakeup-gpios = <&gpiob 13 (0 << 0)>;
  data-gpios = <&gpioe 1 (0 << 0)>;
 };
};

&flash0 {
 partitions {
  compatible = "fixed-partitions";
  #address-cells = <1>;
  #size-cells = <1>;

  boot_partition: partition@0 {
   label = "mcuboot";
   reg = <0x0 ((64) * 1024)>;
   read-only;
  };

  slot0_partition: partition@10000 {
   label = "image-0";
   reg = <0x10000 ((976) * 1024)>;
  };

  slot1_partition: partition@104000 {
   label = "image-1";
   reg = <0x104000 ((976) * 1024)>;
  };

  storage_partition: partition@1f8000 {
   label = "storage";
   reg = <0x1f8000 ((32) * 1024)>;
  };
 };
};

&timers2 {
 status = "okay";

 pwm2: pwm {
  status = "okay";
  pinctrl-0 = <&tim2_ch1_pa15>;
  pinctrl-names = "default";
 };
};

&rtc {
 clocks = <&rcc (0x058) (1 << 28)>,
   <&rcc 0x003 ((((0x90) & 0xFFFFU) << 0U) | (((8) & 0x1FU) << 16U) | ((((9) - (8)) & 0x3U) << 21U) | ((((2)) & 0xFFU) << 24U))>;
 status = "okay";
};

zephyr_udc0: &usbotg_fs {
 pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12
       &usb_otg_fs_id_pa10>;
 pinctrl-names = "default";
 status = "okay";
};

&iwdg {
 status = "okay";
};

&rng {
 status = "okay";
};

&octospi1 {
 pinctrl-0 = <&octospim_p1_clk_pe10 &octospim_p1_ncs_pe11
       &octospim_p1_io0_pe12 &octospim_p1_io1_pe13
       &octospim_p1_io2_pe14 &octospim_p1_io3_pe15>;
 pinctrl-names = "default";

 dmas = <&dma1 0 40 (((2 & 0x3) << 6) | ((1 & 0x1) << 10))>;
 dma-names = "tx_rx";

 status = "okay";

 mx25r6435f: ospi-nor-flash@0 {
  compatible = "st,stm32-ospi-nor";
  reg = <0>;
  size = <(((64) * 1024) * 1024)>;
  ospi-max-frequency = <(((26) * 1000) * 1000)>;
  spi-bus-width = <4>;
  data-rate = <1>;
  writeoc = "PP_1_4_4";

  status = "okay";

  partitions {
   compatible = "fixed-partitions";
   #address-cells = <1>;
   #size-cells = <1>;

   store_partition: partition@0 {
    label = "store";
    reg = <0x0 (((8) * 1024) * 1024)>;
   };
  };
 };
};

&dma1 {
 status = "okay";
};

&dmamux1 {
 status = "okay";
};
