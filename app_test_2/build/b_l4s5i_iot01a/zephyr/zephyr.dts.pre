/ {
    buttons {
        compatible = "gpio-keys";

        ext_button: ext_button {
            gpios = <&gpiob 2 ((1 << 4) | (1 << 0))>;
            label = "External Button";
        };
    };

    aliases {
        sw1 = &ext_button;
    };
};
