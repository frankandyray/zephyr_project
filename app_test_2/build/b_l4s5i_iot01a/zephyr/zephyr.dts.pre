  aes: aes@50060000 {
   compatible = "st,stm32l4-aes", "st,stm32-aes";
   reg = <0x50060000 0x400>;
   clocks = <&rcc (0x04c) (1 << 16)>;
   resets = <&rctl (((0x2C) << 5U) | (16))>;
   interrupts = <79 0>;
   interrupt-names = "aes";
   status = "disabled";
  };
 };
};
# 8 "C:/Users/ray45/zephyrproject/zephyr/dts/arm/st/l4/stm32l4s5Xi.dtsi" 2 3 4

/ {
 soc {
  flash-controller@40022000 {
   flash0: flash@8000000 {
    reg = <0x08000000 ((2048) * 1024)>;
   };
  };
 };
};
