/ {
	/* 統一寫在一個 aliases 區塊 */
	aliases {
		led0 = &green_led_2; /* 對應開發板原本的綠燈 */
		led1 = &pe3_led;     /* 對應你新增的 PE3 LED */
	};

	leds {
		compatible = "gpio-leds";
		pe3_led: pe3_led {
			gpios = <&gpioe 3 GPIO_ACTIVE_HIGH>;
			label = "PE3 LED";
		}; 
	};
};

/*spi腳位設定*/

&spi1 {
	status = "okay";

	adxl345: adxl345@0 {
		compatible = "adi,adxl345";
		reg = <0>; /* 對應 cs-gpios 的第 0 個索引 */
		spi-max-frequency = <5000000>; /* 修正報錯：必須設定頻率 (5 MHz) */
		
	};
};